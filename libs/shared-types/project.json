{
  "name": "shared-types",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared-types/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": "api",
          "target": "generate-types"
        }
      ],
      "options": {
        "command": "tsc --project libs/shared-types/tsconfig.json"
      },
      "outputs": ["{workspaceRoot}/dist/libs/shared-types"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "libs/shared-types"
      }
    }
  },
  "tags": ["type:util", "scope:shared", "lang:typescript"]
}
