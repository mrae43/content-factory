      "post": {
        "tags": [
          "Content Factory"
        ],
        "summary": "Approve Script",
        "operationId": "approve_script_api_v1_jobs__job_id__approve_script_post",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
