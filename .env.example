# ── Shared ──
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/content_factory
GEMINI_API_KEY=your-gemini-api-key
TAVILY_API_KEY=your-tavily-api-key

# ── Backend ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=content_factory
POSTGRES_PORT=5433
PGADMIN_EMAIL=admin@contentfactory.local
PGADMIN_PASSWORD=admin
API_PORT=8000
EVALUATOR_MODEL=gemini-1.5-pro
EVALUATOR_TEMPERATURE=0.0
OPTIMIZER_MODEL=gemini-2.5-flash
OPTIMIZER_TEMPERATURE=0.3
MAX_RED_TEAM_REVISIONS=3

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_PORT=3000
