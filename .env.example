# ── Shared (Required) ──
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/content_factory
GEMINI_API_KEY=your-gemini-api-key
TOGETHER_API_KEY=your-together-api-key
TAVILY_API_KEY=your-tavily-api-key

# ── Backend Infrastructure ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=content_factory
POSTGRES_PORT=5433
PGADMIN_EMAIL=admin@contentfactory.io
PGADMIN_PASSWORD=admin
API_PORT=8000
MAX_RED_TEAM_REVISIONS=3
SIMILARITY_THRESHOLD=0.75
SYNTHID_WATERMARK_ENABLED=True
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_LOCK_TIMEOUT_MINUTES=15

# ── Embedding Model ──
# EMBEDDING_MODEL=models/gemini-embedding-001
# EMBEDDING_DIMENSION=768

# ── Agent Model Overrides ──
# Premium tier (default: meta-llama/Llama-3.3-70B-Instruct-Turbo via Together AI):
# COPYWRITER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# COPYWRITER_TEMPERATURE=0.7
# EVALUATOR_MODEL=gemini-1.5-pro
# EVALUATOR_TEMPERATURE=0.0
#
# Standard tier (default: openai/gpt-oss-20b via Together AI):
# OPTIMIZER_MODEL=openai/gpt-oss-20b
# OPTIMIZER_TEMPERATURE=0.3
# ASSET_MODEL=openai/gpt-oss-20b
# ASSET_TEMPERATURE=0.5
# FORMATTER_MODEL=openai/gpt-oss-20b
# FORMATTER_TEMPERATURE=0.3

# ── Eval Suite (pytest -m eval; uncomment to override defaults) ──
# EVAL_COPYWRITER_MODEL=MiniMaxAI/MiniMax-M2.7
# EVAL_COPYWRITER_TEMPERATURE=0.7
# EVAL_RED_TEAM_MODEL=openai/gpt-oss-120b
# EVAL_RED_TEAM_TEMPERATURE=0.0
# EVAL_OPTIMIZER_MODEL=openai/gpt-oss-20b
# EVAL_OPTIMIZER_TEMPERATURE=0.3
# EVAL_JUDGE_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507-tput
# EVAL_JUDGE_TEMPERATURE=0.0

# ── S3 / SeaweedFS ──
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_IMAGES=
S3_BUCKET_VIDEOS=
S3_PUBLIC_URL=

# ── Discord Bot ──
DISCORD_TOKEN=your-bot-token
DISCORD_GUILD_ID=your-server-id
# DISCORD_CHANNEL_ID=  # optional, default channel for status updates

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_PORT=3000
